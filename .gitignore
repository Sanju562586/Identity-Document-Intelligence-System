# =============================================================================
#  Identity Document Intelligence System — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ───────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/

# ── Secrets & credentials ─────────────────────────────────────────────────────
.env
.env.local
.env.production
secrets.yaml
secrets.json
*_credentials.json
service_account.json

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# ── Model weights & checkpoints ───────────────────────────────────────────────
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
*.pkl
*.joblib
# Keep checkpoint directory structure, ignore weights
!checkpoints/.gitkeep

# ── Training data (large) ─────────────────────────────────────────────────────
data/synthetic/
data/splits/
data/dpo/
# Keep directory scaffolding
!data/.gitkeep
!data/raw/.gitkeep
!data/raw/fonts/.gitkeep

# ── Outputs ───────────────────────────────────────────────────────────────────
outputs/
logs/
runs/
wandb/
mlruns/
lightning_logs/

# ── ML experiment artifacts ───────────────────────────────────────────────────
*.tfevents.*
events.out.*
*.metrics
*.log

# ── HuggingFace cache ─────────────────────────────────────────────────────────
.cache/
~/.cache/huggingface/
huggingface_cache/

# ── Image / media outputs ─────────────────────────────────────────────────────
outputs/**/*.jpg
outputs/**/*.jpeg
outputs/**/*.png
outputs/**/*.gif
outputs/**/*.mp4

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── mypy / type checking ──────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
test-results/

# ── Linting ───────────────────────────────────────────────────────────────────
.ruff_cache/

# ── ONNX / TensorRT exports ───────────────────────────────────────────────────
*.onnx
*.trt
*.engine
*.plan

# ── Temporary files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.swp
scratch/

# ── Large binary assets (commit only fonts via Git LFS if needed) ─────────────
*.ttf
*.otf
*.woff
*.woff2

# ── Kaggle-specific ───────────────────────────────────────────────────────────
kaggle.json

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── Exceptions — always commit these ─────────────────────────────────────────
!.env.example
!requirements.txt
!requirements-dev.txt
!setup.py
!pytest.ini
!config/config.yaml
!scripts/run_all.sh
!scripts/kaggle_setup.sh
